{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build:portal",
  "outputDirectory": "dist-portal",
  "regions": ["gru1"],
  "functions": {
    "api/[...path].mjs": {
      "maxDuration": 60,
      "excludeFiles": "{work/**,portal/data/**,portal/tests/**,docs/**,supabase/**,.env*}"
    }
  },
  "redirects": [
    {
      "source": "/",
      "destination": "/portal/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/portal",
      "destination": "/portal/index.html"
    },
    {
      "source": "/portal/",
      "destination": "/portal/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, private"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'"
        }
      ]
    }
  ],
  "git": {
    "deploymentEnabled": false
  }
}
